# Set this in Render's Environment page; never commit the real value.
# This file is a reference only; the app does not auto-load .env files.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_REASONING=medium
# Optional per-task overrides: ANALYZE_PROVIDER, ANALYZE_MODEL, ANALYZE_REASONING, ASK_PROVIDER, ASK_MODEL, ASK_REASONING
